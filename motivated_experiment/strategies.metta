(= (pickOutsideAF)
    (let $x (getRandomAtomNotInAF)
        (if (== $x ()) (getRandomAtomInAF) $x)
    )
)

(= (applyStrategy narrow-focus)
    (let* (
        ($a (getRandomAtomInAF))
        ($b (getRandomAtomInAF))
        ($c (getRandomAtomInAF))
        ($d (getRandomAtomInAF))
    )
    ($a $b $c $d))
)

(= (applyStrategy expand-focus)
    (let* (
        ($a (getRandomAtomInAF))
        ($b (getRandomAtomInAF))
        ($c (pickOutsideAF))
        ($d (pickOutsideAF))
    )
    ($a $b $c $d))
)

(= (applyStrategy explore-novel)
    (let* (
        ($a (pickOutsideAF))
        ($b (pickOutsideAF))
        ($c (pickOutsideAF))
        ($d (pickOutsideAF))
    )
    ($a $b $c $d))
)
